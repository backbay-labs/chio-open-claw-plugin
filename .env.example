# ─────────────────────────────────────────────────────────────────────────────
# OpenClaw runtime config
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server. OPENCLAW_PUBLIC_URL is the public origin used for countersign
# deep-links embedded in chat approval cards. Must match WEBAUTHN_ORIGIN.
PORT=8787
OPENCLAW_PUBLIC_URL=http://localhost:8787

# ─── trust plane ────────────────────────────────────────────────────────────
# arc trust serve endpoint + service bearer token.
CHIO_TRUST_URL=http://127.0.0.1:8940
CHIO_TRUST_TOKEN=
# Where arc CLI stores receipts (used to build attested passports).
CHIO_RECEIPT_DB=

# ─── WebAuthn (passkey countersign) ─────────────────────────────────────────
# WEBAUTHN_RP_ID must be a hostname (no scheme, no port). For localhost use
# "localhost" with WEBAUTHN_ORIGIN=http://localhost:8787. For production,
# "openclaw.example.com" with WEBAUTHN_ORIGIN=https://openclaw.example.com.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OpenClaw
WEBAUTHN_ORIGIN=http://localhost:8787

# ─── storage ────────────────────────────────────────────────────────────────
DATABASE_PATH=./var/openclaw.sqlite

# ─── Slack ─────────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=
# If set, runs in Socket Mode (no public URL needed for events).
SLACK_APP_TOKEN=

# ─── Discord ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# ─── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── approval thresholds ───────────────────────────────────────────────────
DEFAULT_QUORUM=2
DEFAULT_SIGNERS=3

# ─── shift handoff ─────────────────────────────────────────────────────────
# Optional: path to shifts.yaml for rotating bonds at shift change.
CHIO_SHIFTS_PATH=./var/shifts.yaml
