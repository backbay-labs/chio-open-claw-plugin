{
  "id": "chio-kernel",
  "name": "Chio Kernel",
  "version": "0.1.0",
  "description": "Native Chio execution tool. Requires the restricted profile and a separate protected resource boundary.",
  "contracts": { "tools": ["chio_call"] },
  "toolMetadata": { "chio_call": { "optional": true } },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoint": { "type": "string" },
      "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
      "stateDir": { "type": "string" },
      "subjectKey": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
      "capabilityId": { "type": "string" },
      "serverId": { "type": "string" },
      "sessionId": { "type": "string" },
      "trustedSigners": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } },
      "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 }
    }
  }
}
